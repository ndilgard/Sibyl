[Unit]
Description=HIDS host intrusion detection daemon
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/omv/HIDS

[Service]
Type=simple
ExecStart=/usr/bin/bun run /home/nate/Claude_Code/Projects/HIDS/src/daemon.ts
WorkingDirectory=/home/nate/Claude_Code/Projects/HIDS
Restart=on-failure
RestartSec=5
MemoryHigh=1500M
MemoryMax=2G

[Install]
WantedBy=default.target
