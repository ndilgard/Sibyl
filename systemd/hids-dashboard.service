[Unit]
Description=HIDS dashboard (standalone — independent of hids.service)
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/mnt/omv/HIDS

[Service]
Type=simple
ExecStart=/usr/bin/bun run /home/nate/Claude_Code/Projects/HIDS/src/dashboard.ts
WorkingDirectory=/home/nate/Claude_Code/Projects/HIDS
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
